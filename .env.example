METADATA_ENVIRONMENT=development
METADATA_API_KEYS=local:replace-with-at-least-32-random-characters
METADATA_ALLOWED_HOSTS=localhost,127.0.0.1,metadata-extractor
METADATA_BEDROCK_MODEL_ID=
METADATA_BEDROCK_MAX_TOKENS=8192
AWS_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY=
AWS_BEDROCK_SECRET_KEY=
METADATA_MODEL_TIMEOUT_SECONDS=45
METADATA_REQUEST_TIMEOUT_SECONDS=120
METADATA_MAX_REQUEST_BYTES=2097152
METADATA_MAX_CONCURRENT_REQUESTS=4
METADATA_RATE_LIMIT_PER_MINUTE=60
METADATA_EXPOSE_DOCS=true
